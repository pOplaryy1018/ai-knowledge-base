# ── 应用 ──
APP_NAME=AI 知识库管理平台
APP_VERSION=0.0.1
DEBUG=True

# ── 数据库 (PostgreSQL + pgvector) ──
# 本地开发使用 localhost，Docker Compose 部署使用容器名 postgres
DATABASE_URL=postgresql+asyncpg://admin:devpassword@localhost:15432/ai_knowledge

# ── Redis ──
# 本地开发使用 localhost，Docker Compose 部署使用容器名 redis
REDIS_URL=redis://localhost:16379/0

# ── JWT 认证 ──
# 生产环境务必更换为随机长字符串
JWT_SECRET_KEY=change-me-to-a-random-secret-key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# ── CORS 允许的前端来源 ──
ALLOWED_ORIGINS=["http://localhost:4173","http://localhost:4174"]

# ── LLM 配置 (OpenAI 兼容接口) ──
LLM_API_KEY=sk-your-api-key-here
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat

# ── 种子数据 ──
# 首次启动时自动创建的超级管理员密码（仅本地开发）
SEED_ADMIN_PASSWORD=devpassword

# ── OCR (Docker 环境) ──
# TESSDATA_PREFIX=/usr/share/tesseract-ocr/5/tessdata
