docs/

# ── 构建产物 ──
dist/
build/
*.tsbuildinfo

# ── 环境变量 ──
.env
.env.local
.env.*.local

# ── IDE ──
.vscode/
!.vscode/settings.json
.idea/
*.swp
*.swo
*~

# ── 操作系统 ──
.DS_Store
Thumbs.db

# ── Docker ──
pgdata/

# ── 截图产物 ──
**/screenshots/*.png
**/screenshots/*.jpg

# ── 上传 / 临时文件 ──
uploads/
temp/

